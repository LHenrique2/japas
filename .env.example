# ── Japa's House Bistrô — configuração do backend ─────────────────────
# Copie este arquivo para ".env" e ajuste os valores antes de publicar.

# Porta do servidor (Render/Railway injetam PORT automaticamente)
PORT=3000

# Segredo do JWT — use uma string longa e aleatória em produção.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria

# Caminho do banco SQLite (relativo à raiz do projeto). Deixe o padrão.
DB_PATH=server/data/japa.sqlite

# Senha do painel do gerente (usuário: admin).
# OBRIGATÓRIA em produção: sem ela o servidor não sobe (NODE_ENV=production),
# para nunca existir um painel com senha padrão conhecida.
# Em desenvolvimento, se ficar vazia, o admin é criado com a senha "1234".
ADMIN_PASSWORD=troque-esta-senha-do-painel-do-gerente
